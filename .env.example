# ---------------------------------------------------------------------------
# Portfolio Intelligence local configuration
# Copy to .env or run: python scripts/bootstrap_env.py
# Never commit real values.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# Local development identity only. Production uses OIDC.
DEV_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ID=00000000-0000-0000-0000-000000000002

# Database
POSTGRES_DB=portfolio_intelligence
POSTGRES_USER=portfolio_admin
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
DATABASE_URL=postgresql+asyncpg://portfolio_admin:REPLACE_WITH_GENERATED_SECRET@postgres:5432/portfolio_intelligence
POSTGRES_CHECKPOINT_DSN=postgresql://portfolio_admin:REPLACE_WITH_GENERATED_SECRET@postgres:5432/portfolio_intelligence
RDS_IAM_AUTH=false

# Redis
REDIS_URL=redis://redis:6379/0

# Object storage
STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=portfolio-intelligence
OBJECT_STORAGE_ACCESS_KEY=portfolio-local
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_KMS_KEY_ID=
OBJECT_STORAGE_PRESIGN_SECONDS=600

# File security
MAX_UPLOAD_BYTES=52428800
MALWARE_SCAN_REQUIRED=false
DIRECT_UPLOAD_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Encryption and browser sessions
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
SESSION_SECRET=REPLACE_WITH_GENERATED_SECRET
AGENT_CORE_SHARED_SECRET=REPLACE_WITH_GENERATED_SECRET
PUBLIC_APP_ORIGIN=http://localhost:3000

# AI provider. Required only for live AI-generated answers.
OPENAI_API_KEY=
OPENAI_MODEL=
AGENT_MAX_STEPS=16
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_COST_USD=1.00

# Optional agent tracing. Do not put keys in browser variables.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio-intelligence

# Core service endpoints
CORE_API_URL=http://api:8000
NEXT_PUBLIC_APP_NAME=Portfolio Intelligence
INTERNAL_API_URL=http://api:8000
INTERNAL_AGENT_URL=http://agents:8001

# Production authentication. Required before public deployment.
OIDC_ISSUER_URL=
OIDC_OAUTH_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPES=openid email profile
OIDC_REQUIRED_SCOPES=openid
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
IDENTITY_PROPAGATION_ENABLED=false
RLS_VERIFICATION_COMPLETE=false
TELEMETRY_REDACTION_VERIFIED=false
AGENT_EVALUATION_VERIFIED=false

# Production control plane and metadata-only OpenTelemetry export.
AWS_REGION=ap-south-1
JOB_QUEUE_URL=
AUDIT_QUEUE_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
KMS_DATA_KEY_ID=
KMS_CAPABILITY_SIGNING_KEY_ID=

# Optional read-only Upstox connection. Do not request order scopes.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/v1/connections/upstox/callback

# Optional Sites Gmail statement intake. Keep both secrets server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-SITE.example/api/connections/google/callback
CONNECTOR_ENCRYPTION_KEY=

# Optional licensed market/news provider selected during Phase 0.
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
NEWS_DATA_BASE_URL=
NEWS_DATA_API_KEY=
